@using Grooming_Management_Frontend.Services
@inherits LayoutComponentBase
@inject TokenStore TokenStore
@inject ApiClient Api
@inject NavigationManager Navigation

<MudLayout>

    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6">Grooming Management</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="mr-3">
            @(TokenStore.IsOwner ? "Właściciel" : "Groomer")@(TokenStore.FullName != null ? $" - {TokenStore.FullName}" : "")
        </MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="LogoutAsync" />
    </MudAppBar>

    <MudDrawer @bind-Open="drawerOpen" Elevation="2">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {

    private bool drawerOpen = true;

    private void ToggleDrawer() => drawerOpen = !drawerOpen;

    protected override void OnInitialized()
    {
        TokenStore.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        TokenStore.OnChange -= StateHasChanged;
    }

    private async Task LogoutAsync()
    {
        if (TokenStore.RefreshToken != null)
        {
            await Api.PostAsync<object?>(
                $"api/Auth/Logout?refreshToken={Uri.EscapeDataString(TokenStore.RefreshToken)}", null);
        }

        await TokenStore.ClearAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}