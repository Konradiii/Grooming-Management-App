@using Grooming_Management_Frontend.Services
@inherits LayoutComponentBase
@inject TokenStore TokenStore
@inject ApiClient Api
@inject NavigationManager Navigation
@implements IDisposable

<MudLayout>

    <MudAppBar Elevation="0">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Style="letter-spacing:-.03em;font-weight:700;">Groomsli</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="mr-3 d-none d-sm-flex">
            @(TokenStore.IsOwner ? "Właściciel" : "Groomer")@(TokenStore.FullName != null ? $" - {TokenStore.FullName}" : "")
        </MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="LogoutAsync" />
    </MudAppBar>

    <MudDrawer @bind-Open="drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        @if (TokenStore.IsSuspended)
        {
            <MudAlert Severity="Severity.Error" Square="true" Class="mb-0">
                Dostęp wstrzymany z powodu braku płatności.
                <MudLink Href="/ustawienia" Color="Color.Inherit"><b>Opłać abonament</b></MudLink>
            </MudAlert>
        }
        else if (TokenStore.IsPastDue)
        {
            <MudAlert Severity="Severity.Warning" Square="true" Class="mb-0">
                Abonament wygasł. Opłać go, zanim dostęp zostanie wstrzymany.
                <MudLink Href="/ustawienia" Color="Color.Inherit"><b>Przejdź do ustawień</b></MudLink>
            </MudAlert>
        }
        else if (TokenStore.IsTrial)
        {
            <MudAlert Severity="Severity.Info" Square="true" Class="mb-0">
                Korzystasz z bezpłatnego okresu próbnego.
                <MudLink Href="/ustawienia" Color="Color.Inherit"><b>Zobacz szczegóły</b></MudLink>
            </MudAlert>
        }

        @if (TokenStore.IsSmsEmpty && !TokenStore.SmsWarningDismissed)
        {
            <MudAlert Severity="Severity.Error" Square="true" Class="mb-0"
                      ShowCloseIcon="true" CloseIconClicked="TokenStore.DismissSmsWarning">
                Wyczerpano limit SMS-ów. Powiadomienia nie będą wysyłane.
                @if (TokenStore.IsOwner)
                {
                    <MudLink Href="/ustawienia" Color="Color.Inherit"><b>Doładuj pakiet</b></MudLink>
                }
            </MudAlert>
        }
        else if (TokenStore.IsSmsLow && !TokenStore.SmsWarningDismissed)
        {
            <MudAlert Severity="Severity.Warning" Square="true" Class="mb-0"
                      ShowCloseIcon="true" CloseIconClicked="TokenStore.DismissSmsWarning">
                Zostało @TokenStore.SmsRemaining SMS-ów.
                @if (TokenStore.IsOwner)
                {
                    <MudLink Href="/ustawienia" Color="Color.Inherit"><b>Doładuj pakiet</b></MudLink>
                }
            </MudAlert>
        }

        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {

    private bool drawerOpen = true;

    private void ToggleDrawer() => drawerOpen = !drawerOpen;

    protected override void OnInitialized()
    {
        TokenStore.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        TokenStore.OnChange -= StateHasChanged;
    }

    private async Task LogoutAsync()
    {
        if (TokenStore.RefreshToken != null)
        {
            await Api.PostAsync<object?>(
                $"api/Auth/Logout?refreshToken={Uri.EscapeDataString(TokenStore.RefreshToken)}", null);
        }

        await TokenStore.ClearAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}