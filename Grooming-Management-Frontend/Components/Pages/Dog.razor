@page "/psy"
@rendermode InteractiveServer
@inherits AuthenticatedPage
@using Grooming_Management_App.DTOs.DogDTO
@inject IHttpClientFactory HttpClientFactory


<MudText Typo="Typo.h5" Class="mb-4">Psy</MudText>

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (errorMessage != null)
{
    <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
}
else
{
    <MudTable Items="dogs" Hover="true" Striped="true">
        <HeaderContent>
            <MudTh>Imię</MudTh>
            <MudTh>Rasa</MudTh>
            <MudTh>Właściciel</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.BreedName</MudTd>
            <MudTd>@context.DogOwnerFullName</MudTd>
        </RowTemplate>
        
    </MudTable>
}

@code
{

    private List<GetDogDto> dogs = new();
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            await LoadDogsAsync();
            StateHasChanged();
        }
    }
    private async Task LoadDogsAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("Api");
            TokenStore.ApplyTo(client);

            var result = await client.GetFromJsonAsync<List<GetDogDto>>("api/Dog");
            dogs = result ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"Nie udało się pobrać danych: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
        
        
    }


}
