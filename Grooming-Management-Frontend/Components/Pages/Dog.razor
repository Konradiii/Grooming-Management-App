@page "/psy"
@rendermode InteractiveServer
@inherits AuthenticatedPage
@using Grooming_Management_App.DTOs.DogDTO
@using Grooming_Management_Frontend.Components.Dialogs
@using Grooming_Management_Frontend.Services
@inject ApiClient Api
@inject IDialogService DialogService

<MudText Typo="Typo.h5" Class="mb-4">Psy</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary"
           StartIcon="@Icons.Material.Filled.Add"
           OnClick="OpenAddDialog" Class="mb-4">
    Dodaj psa
</MudButton>

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (errorMessage != null)
{
    <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
}
else
{
    <MudTable Items="dogs" Hover="true" Striped="true"
              T="GetDogDto"
              Filter="FilterDog"
              OnRowClick="@((TableRowClickEventArgs<GetDogDto> args) => OpenDetails(args.Item!.Id))">
        <ToolBarContent>
            <MudTextField @bind-Value="searchText"
                          Placeholder="Szukaj po imieniu, rasie lub właścicielu"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Immediate="true"
                          Clearable="true"
                          Class="mt-0" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Imię</MudTh>
            <MudTh>Rasa</MudTh>
            <MudTh>Właściciel</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.BreedName</MudTd>
            <MudTd>@context.DogOwnerFullName</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Brak psów spełniających kryteria</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code
{
    private List<GetDogDto> dogs = new();
    private string searchText = string.Empty;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            await LoadDogsAsync();
            StateHasChanged();
        }
    }

    private async Task LoadDogsAsync()
    {
        try
        {
            var result = await Api.GetAsync<List<GetDogDto>>("api/Dog");
            dogs = result ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"Nie udało się pobrać danych: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool FilterDog(GetDogDto dog)
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return true;

        return dog.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || dog.BreedName.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || dog.DogOwnerFullName.Contains(searchText, StringComparison.OrdinalIgnoreCase);
    }

    private async Task OpenAddDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddDogDialog>("Nowy pies", options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDogsAsync();
            StateHasChanged();
        }
    }

    private void OpenDetails(int dogId)
    {
        Navigation.NavigateTo($"/psy/{dogId}");
    }
}