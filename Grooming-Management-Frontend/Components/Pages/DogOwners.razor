@page "/wlasciciele"
@rendermode InteractiveServer
@inherits AuthenticatedPage
@using Grooming_Management_App.DTOs.DogOwnerDTO
@using Grooming_Management_Frontend.Components.Dialogs
@using Grooming_Management_Frontend.Services
@inject ApiClient Api
@inject IDialogService DialogService

<MudText Typo="Typo.h5" Class="mb-4">Właściciele</MudText>

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (errorMessage != null)
{
    <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
}
else
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenAddDialog" Class="mb-4">
        Dodaj właściciela
    </MudButton>

    <MudTable Items="owners" Hover="true" Striped="true"
              T="GetDogOwnerDto"
              Filter="FilterOwner"
              OnRowClick="@((TableRowClickEventArgs<GetDogOwnerDto> args) => Navigation.NavigateTo($"/wlasciciele/{args.Item!.Id}"))">
        <ToolBarContent>
            <MudTextField @bind-Value="searchText"
                          Placeholder="Szukaj po nazwisku lub telefonie"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Immediate="true"
                          Clearable="true"
                          Class="mt-0" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Imię</MudTh>
            <MudTh>Nazwisko</MudTh>
            <MudTh>Telefon</MudTh>
            <MudTh>Psy</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.FirstName</MudTd>
            <MudTd>@context.LastName</MudTd>
            <MudTd>@context.Phone</MudTd>
            <MudTd>@context.DogsCount</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Brak właścicieli spełniających kryteria</MudText>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private List<GetDogOwnerDto> owners = new();
    private string searchText = string.Empty;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            await LoadOwnersAsync();
            StateHasChanged();
        }
    }

    private async Task LoadOwnersAsync()
    {
        try
        {
            var result = await Api.GetAsync<List<GetDogOwnerDto>>("api/DogOwner");
            owners = result ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"Nie udało się pobrać danych: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool FilterOwner(GetDogOwnerDto owner)
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return true;

        var digits = new string(searchText.Where(char.IsDigit).ToArray());

        return owner.FirstName.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || owner.LastName.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || (digits.Length > 0 && owner.Phone.Contains(digits));
    }

    private async Task OpenAddDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddDogOwnerDialog>("Nowy właściciel", options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadOwnersAsync();
            StateHasChanged();
        }
    }
}