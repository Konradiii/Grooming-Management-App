@page "/"
@rendermode InteractiveServer
@inherits AuthenticatedPage
@using Grooming_Management_App.DTOs.VisitDTO
@using Grooming_Management_App.DTOs.EarningDTO
@using Grooming_Management_App.Enums
@using Grooming_Management_Frontend.Components.Dialogs
@using Grooming_Management_Frontend.Services
@inject ApiClient Api
@inject IDialogService DialogService
@inject NavigationManager Navigation

<div class="d-flex align-center justify-space-between mb-4">
    <div>
        <MudText Typo="Typo.h5">Dzisiaj</MudText>
        <MudText Typo="Typo.body2">@DateTime.Today.ToString("dddd, d MMMM yyyy")</MudText>
    </div>

    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenAddVisitDialog">
        Dodaj wizytę
    </MudButton>
</div>

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudGrid Class="mb-4">
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.body2">Wizyt dzisiaj</MudText>
                <MudText Typo="Typo.h4">@visits.Count</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.body2">Przed nami</MudText>
                <MudText Typo="Typo.h4">@UpcomingCount</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.body2">Ukończone</MudText>
                <MudText Typo="Typo.h4">@CompletedCount</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.body2">Dzisiejszy przychód</MudText>
                <MudText Typo="Typo.h4">@((earnings?.Earnings ?? 0).ToString("0.00")) zł</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (!visits.Any())
    {
        <MudAlert Severity="Severity.Info">Brak wizyt na dzisiaj</MudAlert>
    }
    else
    {
        <MudTable Items="visits.OrderBy(v => v.Date)" Hover="true" Striped="true"
                  T="GetAllVisitsDto"
                  OnRowClick="@((TableRowClickEventArgs<GetAllVisitsDto> args) => OpenVisitDetails(args.Item!.Id))">
            <HeaderContent>
                <MudTh>Godzina</MudTh>
                <MudTh>Pies</MudTh>
                <MudTh>Rasa</MudTh>
                <MudTh>Usługa</MudTh>
                <MudTh>Groomer</MudTh>
                <MudTh>Status</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Date.ToString("HH:mm")</MudTd>
                <MudTd>@context.DogName</MudTd>
                <MudTd>@context.BreedName</MudTd>
                <MudTd>@context.ServiceName</MudTd>
                <MudTd>@context.GroomerName</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@EnumLabels.StatusColor(context.Status)">
                        @EnumLabels.Status(context.Status)
                    </MudChip>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    <MudButton Variant="Variant.Text" Color="Color.Primary"
               EndIcon="@Icons.Material.Filled.ArrowForward"
               OnClick="@(() => Navigation.NavigateTo("/kalendarz"))" Class="mt-4">
        Zobacz kalendarz
    </MudButton>
}

@if (errorMessage != null)
{
    <MudAlert Severity="Severity.Error" Class="mt-4">@errorMessage</MudAlert>
}

@code {
    private List<GetAllVisitsDto> visits = new();
    private GetEarningForPeriodDto? earnings;
    private bool isLoading = true;
    private string? errorMessage;

    private int UpcomingCount => visits.Count(v =>
        v.Status == StatusEnum.Scheduled && v.Date > DateTime.Now);

    private int CompletedCount => visits.Count(v => v.Status == StatusEnum.Completed);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            await LoadDataAsync();
            StateHasChanged();
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            var from = DateTime.Today.ToString("yyyy-MM-ddTHH:mm:ss");
            var to = DateTime.Today.AddDays(1).ToString("yyyy-MM-ddTHH:mm:ss");

            visits = await Api.GetAsync<List<GetAllVisitsDto>>(
                $"api/Visit?DateFrom={from}&DateTo={to}") ?? new();

            earnings = await Api.GetAsync<GetEarningForPeriodDto>(
                $"api/Earnings/GetByPeriod?dateFrom={from}&dateTo={to}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Nie udało się pobrać danych: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenVisitDetails(int visitId)
    {
        var parameters = new DialogParameters<VisitDetailsDialog>
        {
            { x => x.VisitId, visitId }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<VisitDetailsDialog>("Szczegóły wizyty", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDataAsync();
            StateHasChanged();
        }
    }

    private async Task OpenAddVisitDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddVisitDialog>("Nowa wizyta", options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDataAsync();
            StateHasChanged();
        }
    }
}