@page "/zmiana-hasla"
@rendermode InteractiveServer
@layout EmptyLayout
@using Grooming_Management_App.DTOs.AuthDTO
@using Grooming_Management_Frontend.Services
@inject ApiClient Api
@inject TokenStore TokenStore
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudPaper Class="pa-8">
        <MudText Typo="Typo.h5" Class="mb-2">Zmiana hasła</MudText>
        <MudText Typo="Typo.body2" Class="mb-6">
            Ustaw własne hasło, żeby korzystać z systemu.
        </MudText>

        <MudTextField @bind-Value="oldPassword" Label="Obecne hasło"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined" Class="mb-3" />

        <MudTextField @bind-Value="newPassword" Label="Nowe hasło"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined" Class="mb-3" />

        <MudTextField @bind-Value="confirmPassword" Label="Powtórz nowe hasło"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined" Class="mb-4" />

        @if (errorMessage != null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                   Disabled="isSaving" OnClick="SaveAsync">
            @(isSaving ? "Zapisywanie..." : "Zmień hasło")
        </MudButton>
    </MudPaper>
</MudContainer>

@code {
    private string oldPassword = string.Empty;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;

    private string? errorMessage;
    private bool isSaving;

    private async Task SaveAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(oldPassword))
        {
            errorMessage = "Podaj obecne hasło";
            return;
        }

        if (string.IsNullOrWhiteSpace(newPassword))
        {
            errorMessage = "Podaj nowe hasło";
            return;
        }

        if (newPassword != confirmPassword)
        {
            errorMessage = "Hasła nie są takie same";
            return;
        }

        if (newPassword == oldPassword)
        {
            errorMessage = "Nowe hasło musi różnić się od obecnego";
            return;
        }

        isSaving = true;

        try
        {
            var dto = new ChangePasswordDto
            {
                CurrentPassword = oldPassword,
                NewPassword = newPassword,
                ConfirmNewPassword = confirmPassword
            };
            


            var response = await Api.PostAsync("api/Auth/ChangePassword", dto);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await ApiClient.ReadErrorAsync(response);
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<LoginResponseDto>();

            if (result != null)
            {
                await TokenStore.SetTokensAsync(result.AccessToken, result.RefreshToken, false);
            }

            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = $"Błąd: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}