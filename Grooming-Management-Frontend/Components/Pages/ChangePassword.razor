@page "/zmiana-hasla"
@rendermode InteractiveServer
@layout EmptyLayout
@using Grooming_Management_App.DTOs.AuthDTO
@using Grooming_Management_Frontend.Services
@inject ApiClient Api
@inject TokenStore TokenStore
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Class="pa-8">
        <MudText Typo="Typo.h5" Class="mb-2">Zmiana hasła</MudText>
        <MudText Typo="Typo.body2" Class="mb-6">
            Zanim zaczniesz korzystać z aplikacji, ustaw własne hasło.
        </MudText>

        <MudTextField @bind-Value="currentPassword" Label="Obecne hasło"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined" Class="mb-3" />

        <MudTextField @bind-Value="newPassword" Label="Nowe hasło"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined" Class="mb-3" />

        <MudTextField @bind-Value="confirmNewPassword" Label="Powtórz nowe hasło"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined" Class="mb-4" />

        @if (errorMessage != null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                   Disabled="isSaving" OnClick="SaveAsync" Class="mb-3">
            @(isSaving ? "Zapisywanie..." : "Zmień hasło")
        </MudButton>

        <MudButton Variant="Variant.Text" FullWidth="true" OnClick="LogoutAsync">
            Wyloguj się
        </MudButton>
    </MudPaper>
</MudContainer>

@code {
    private string currentPassword = string.Empty;
    private string newPassword = string.Empty;
    private string confirmNewPassword = string.Empty;

    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (!TokenStore.IsLoggedIn)
            await TokenStore.LoadFromStorageAsync();

        if (!TokenStore.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(currentPassword))
        {
            errorMessage = "Podaj obecne hasło";
            return;
        }

        if (string.IsNullOrWhiteSpace(newPassword))
        {
            errorMessage = "Podaj nowe hasło";
            return;
        }

        if (newPassword != confirmNewPassword)
        {
            errorMessage = "Hasła nie są takie same";
            return;
        }

        if (newPassword == currentPassword)
        {
            errorMessage = "Nowe hasło musi różnić się od obecnego";
            return;
        }

        isSaving = true;

        try
        {
            var dto = new ChangePasswordDto
            {
                CurrentPassword = currentPassword,
                NewPassword = newPassword,
                ConfirmNewPassword = confirmNewPassword
            };

            var response = await Api.PostAsync("api/Auth/ChangePassword", dto);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await ApiClient.ReadErrorAsync(response);
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<LoginResponseDto>();

            if (result == null)
            {
                errorMessage = "Nieprawidłowa odpowiedź serwera";
                return;
            }

            await TokenStore.SetTokensAsync(result.AccessToken, result.RefreshToken, result.RequiresPasswordChange);
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            errorMessage = $"Błąd: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task LogoutAsync()
    {
        await TokenStore.ClearAsync();
        Navigation.NavigateTo("/login");
    }
}