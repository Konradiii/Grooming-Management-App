@page "/ustawienia"
@rendermode InteractiveServer
@inherits OwnerOnlyPage
@using Grooming_Management_App.DTOs.SalonDTO
@using Grooming_Management_App.DTOs.SubscriptionDTO
@using Grooming_Management_App.Enums
@using Grooming_Management_Frontend.Services
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudText Typo="Typo.h5" Class="mb-4">Ustawienia salonu</MudText>

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (salon == null)
{
    <MudAlert Severity="Severity.Error">Nie udało się pobrać danych salonu</MudAlert>
}
else
{
    <MudPaper Class="pa-6 mb-4">
        <MudText Typo="Typo.h6" Class="mb-4">Dane salonu</MudText>

        <MudTextField @bind-Value="name" Label="Nazwa" Variant="Variant.Outlined" Class="mb-3" />

        <MudTextField @bind-Value="phone" Label="Telefon kontaktowy"
                      Variant="Variant.Outlined" Class="mb-3" />

        <MudGrid>
            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="street" Label="Ulica" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="6" md="2">
                <MudTextField @bind-Value="buildingNumber" Label="Nr budynku" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="6" md="2">
                <MudTextField @bind-Value="apartmentNumber" Label="Nr lokalu" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="postalCode" Label="Kod pocztowy" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="city" Label="Miasto" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                   Disabled="isSaving" OnClick="SaveAsync">
            @(isSaving ? "Zapisywanie..." : "Zapisz zmiany")
        </MudButton>
    </MudPaper>

    <MudPaper Class="pa-6 mb-4">
        <MudText Typo="Typo.h6" Class="mb-4">Wiadomości SMS</MudText>

        @if (smsBalance == null)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        }
        else
        {
            @if (smsBalance.Remaining == 0)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">
                    Wyczerpano limit. Powiadomienia SMS nie będą wysyłane, dopóki nie doładujesz pakietu.
                </MudAlert>
            }
            else if (smsBalance.Remaining <= 20)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4">
                    Zostało niewiele wiadomości. Warto doładować pakiet.
                </MudAlert>
            }

            <MudGrid Class="mb-4">
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2">Pozostało wiadomości</MudText>
                    <MudText Typo="Typo.h6" Class="mt-1">@smsBalance.Remaining</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2">Pakiet odnawia się</MudText>
                    <MudText Typo="Typo.h6" Class="mt-1">@smsBalance.ResetDate.ToString("dd.MM.yyyy")</MudText>
                </MudItem>
            </MudGrid>

            <MudText Typo="Typo.body2" Class="mb-4">
                W abonamencie masz 200 wiadomości miesięcznie. Niewykorzystane nie przechodzą
                na kolejny miesiąc. Dokupione pakiety nie wygasają.
            </MudText>

            <MudText Typo="Typo.subtitle2" Class="mb-2">Doładuj pakiet</MudText>

            <div class="d-flex flex-wrap gap-2">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           Disabled="isRedirecting" OnClick="@(() => TopUpAsync(50))">
                    50 SMS - 12,50 zł
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           Disabled="isRedirecting" OnClick="@(() => TopUpAsync(100))">
                    100 SMS - 25 zł
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           Disabled="isRedirecting" OnClick="@(() => TopUpAsync(200))">
                    200 SMS - 50 zł
                </MudButton>
            </div>
        }

        <MudDivider Class="my-4" />

        <div class="d-flex align-center gap-3 mb-1">
            <MudText Typo="Typo.subtitle1">Automatyczne przypomnienia</MudText>
            <MudChip T="string" Size="Size.Small" Color="Color.Default">Wkrótce</MudChip>
        </div>
        <MudText Typo="Typo.body2" Class="mb-4">
            Wiadomość wysyłana klientowi przed umówioną wizytą.
        </MudText>

        <MudSwitch T="bool" @bind-Value="remindersEnabled" Color="Color.Primary"
                   Disabled="true" Class="mb-3">
            Wysyłaj przypomnienia o wizytach
        </MudSwitch>

        <MudSelect T="int" @bind-Value="reminderHoursBefore"
                   Label="Wyprzedzenie" Variant="Variant.Outlined"
                   Disabled="true" Class="mb-3" Style="max-width: 400px;">
            <MudSelectItem T="int" Value="2">2 godziny przed wizytą</MudSelectItem>
            <MudSelectItem T="int" Value="6">6 godzin przed wizytą</MudSelectItem>
            <MudSelectItem T="int" Value="12">12 godzin przed wizytą</MudSelectItem>
            <MudSelectItem T="int" Value="24">Dzień przed wizytą</MudSelectItem>
            <MudSelectItem T="int" Value="48">Dwa dni przed wizytą</MudSelectItem>
        </MudSelect>
    </MudPaper>

    <MudPaper Class="pa-6">
        <MudText Typo="Typo.h6" Class="mb-4">Subskrypcja</MudText>

        @if (subscription == null)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        }
        else
        {
            @if (subscription.Status == SubscriptionStatusEnum.Suspended)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">
                    Dostęp został wstrzymany z powodu braku płatności. Opłać abonament, aby odblokować dodawanie wizyt.
                </MudAlert>
            }
            else if (subscription.Status == SubscriptionStatusEnum.PastDue)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4">
                    Abonament wygasł. Masz tydzień na opłacenie, zanim dostęp zostanie wstrzymany.
                </MudAlert>
            }
            else if (subscription.Status == SubscriptionStatusEnum.Trial)
            {
                <MudAlert Severity="Severity.Info" Class="mb-4">
                    Korzystasz z bezpłatnego okresu próbnego.
                </MudAlert>
            }

            <MudGrid Class="mb-4">
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2">Status</MudText>
                    <MudText Typo="Typo.h6" Class="mt-1">@StatusLabel(subscription.Status)</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2">
                        @(subscription.Status == SubscriptionStatusEnum.Trial ? "Okres próbny do" : "Opłacone do")
                    </MudText>
                    <MudText Typo="Typo.h6" Class="mt-1">
                        @(subscription.ValidUntil?.ToString("dd.MM.yyyy") ?? "bezterminowo")
                    </MudText>
                </MudItem>
            </MudGrid>

            @if (subscription.Status == SubscriptionStatusEnum.Active)
            {
                <MudText Typo="Typo.body2" Class="mb-3">
                    Abonament odnawia się automatycznie co miesiąc. W panelu płatności zmienisz kartę,
                    pobierzesz faktury albo anulujesz subskrypcję.
                </MudText>

                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mb-6"
                           Disabled="isRedirecting" OnClick="OpenPortalAsync">
                    @(isRedirecting ? "Przekierowanie..." : "Zarządzaj płatnościami")
                </MudButton>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mb-3">
                    Plan miesięczny - 109 zł. Pełny dostęp, bez limitu pracowników i wizyt,
                    200 wiadomości SMS miesięcznie.
                    Abonament odnawia się automatycznie, możesz zrezygnować w każdej chwili.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-6"
                           Disabled="isRedirecting" OnClick="StartCheckoutAsync">
                    @(isRedirecting ? "Przekierowanie..." : "Opłać abonament")
                </MudButton>
            }

            <MudText Typo="Typo.subtitle2" Class="mb-3">Historia płatności</MudText>

            @if (!subscription.Payments.Any())
            {
                <MudAlert Severity="Severity.Info">Brak płatności</MudAlert>
            }
            else
            {
                <MudTable Items="subscription.Payments" Hover="true" Striped="true" Dense="true">
                    <HeaderContent>
                        <MudTh>Data</MudTh>
                        <MudTh>Kwota</MudTh>
                        <MudTh>Okres</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh Style="width: 60px;" />
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@EnumLabels.LocalDateTime(context.PaymentDate)</MudTd>
                        <MudTd>@context.Amount.ToString("0.00") @context.Currency</MudTd>
                        <MudTd>@context.PeriodStart.ToString("dd.MM.yyyy") – @context.PeriodEnd.ToString("dd.MM.yyyy")</MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Color="@PaymentColor(context.Status)">
                                @PaymentLabel(context.Status)
                            </MudChip>
                        </MudTd>
                        <MudTd>
                            @if (context.InvoiceUrl != null)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Receipt" Size="Size.Small"
                                               Href="@context.InvoiceUrl" Target="_blank" />
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        }
    </MudPaper>
}

@code {
    private GetSalonDto? salon;
    private GetSubscriptionDto? subscription;
    private GetSmsBalanceDto? smsBalance;

    private bool isLoading = true;
    private bool isSaving;
    private bool isRedirecting;

    private string name = string.Empty;
    private string? phone;
    private string? street;
    private string? buildingNumber;
    private string? apartmentNumber;
    private string? postalCode;
    private string? city;

    private bool remindersEnabled;
    private int reminderHoursBefore = 24;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (!firstRender) return;

        await LoadDataAsync();

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        if (query["platnosc"] == "ok")
        {
            if (subscription?.Status == SubscriptionStatusEnum.Active
                && TokenStore.SubscriptionStatus != "Active")
            {
                await Api.RefreshTokenAsync();
            }

            if (smsBalance != null)
            {
                TokenStore.SetSmsRemaining(smsBalance.Remaining);
            }
        }

        StateHasChanged();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            salon = await Api.GetAsync<GetSalonDto>("api/Salon");

            if (salon != null)
            {
                name = salon.Name;
                phone = salon.Phone;
                street = salon.Street;
                buildingNumber = salon.BuildingNumber;
                apartmentNumber = salon.ApartmentNumber;
                postalCode = salon.PostalCode;
                city = salon.City;
                remindersEnabled = salon.RemindersEnabled;
                reminderHoursBefore = salon.ReminderHoursBefore;
            }

            smsBalance = await Api.GetAsync<GetSmsBalanceDto>("api/Salon/sms-balance");
            subscription = await Api.GetAsync<GetSubscriptionDto>("api/Subscription");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nie udało się pobrać danych: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            Snackbar.Add("Podaj nazwę salonu", Severity.Warning);
            return;
        }

        if (!string.IsNullOrWhiteSpace(postalCode))
        {
            var digits = new string(postalCode.Where(char.IsDigit).ToArray());

            if (digits.Length != 5)
            {
                Snackbar.Add("Nieprawidłowy kod pocztowy (format 00-000)", Severity.Warning);
                return;
            }
        }

        isSaving = true;

        try
        {
            var dto = new UpdateSalonDto
            {
                Name = name,
                Phone = phone,
                Street = street,
                BuildingNumber = buildingNumber,
                ApartmentNumber = apartmentNumber,
                PostalCode = postalCode,
                City = city,
                RemindersEnabled = remindersEnabled,
                ReminderHoursBefore = reminderHoursBefore
            };

            var response = await Api.PutAsync("api/Salon", dto);

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(await ApiClient.ReadErrorAsync(response), Severity.Error);
                return;
            }

            Snackbar.Add("Zapisano zmiany", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task StartCheckoutAsync() => await RedirectToStripeAsync("api/Subscription/checkout");

    private async Task TopUpAsync(int packageSize)
        => await RedirectToStripeAsync($"api/Subscription/sms-topup?packageSize={packageSize}");

    private async Task OpenPortalAsync() => await RedirectToStripeAsync("api/Subscription/portal");

    private async Task RedirectToStripeAsync(string endpoint)
    {
        isRedirecting = true;

        try
        {
            var response = await Api.PostAsync<object?>(endpoint, null);

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(await ApiClient.ReadErrorAsync(response), Severity.Error);
                return;
            }

            var url = (await response.Content.ReadAsStringAsync()).Trim('"');

            if (string.IsNullOrWhiteSpace(url))
            {
                Snackbar.Add("Nie udało się otworzyć strony płatności", Severity.Error);
                return;
            }

            await JS.InvokeVoidAsync("open", url, "_blank");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd: {ex.Message}", Severity.Error);
        }
        finally
        {
            isRedirecting = false;
        }
    }

    private static string StatusLabel(SubscriptionStatusEnum status) => status switch
    {
        SubscriptionStatusEnum.Trial => "Okres próbny",
        SubscriptionStatusEnum.Active => "Aktywna",
        SubscriptionStatusEnum.PastDue => "Zaległość",
        SubscriptionStatusEnum.Suspended => "Wstrzymana",
        _ => status.ToString()
    };

    private static string PaymentLabel(PaymentStatusEnum status) => status switch
    {
        PaymentStatusEnum.Succeeded => "Opłacona",
        PaymentStatusEnum.Failed => "Nieudana",
        PaymentStatusEnum.Refunded => "Zwrócona",
        _ => status.ToString()
    };

    private static Color PaymentColor(PaymentStatusEnum status) => status switch
    {
        PaymentStatusEnum.Succeeded => Color.Success,
        PaymentStatusEnum.Failed => Color.Error,
        _ => Color.Default
    };
}