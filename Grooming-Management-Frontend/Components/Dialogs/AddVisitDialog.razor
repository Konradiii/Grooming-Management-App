@using Grooming_Management_App.DTOs.VisitDTO
@using Grooming_Management_App.DTOs.DogDTO
@using Grooming_Management_App.DTOs.GroomerDTO
@using Grooming_Management_App.DTOs.ServiceBreedDTO
@using Grooming_Management_App.DTOs.Breed
@using Grooming_Management_App.Enums
@using Grooming_Management_Frontend.Services
@using Grooming_Management_Frontend.Components.Shared
@inject ApiClient Api

<MudDialog>
    <DialogContent>
        <MudCheckBox @bind-Value="withNewDog" Label="Nowy klient" Class="mb-4" />

        @if (withNewDog)
        {
            <MudText Typo="Typo.subtitle2" Class="mb-2">Właściciel</MudText>
            <MudTextField @bind-Value="firstName" Label="Imię" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="lastName" Label="Nazwisko" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="phone" Label="Telefon" Variant="Variant.Outlined" Class="mb-4" />

            <MudText Typo="Typo.subtitle2" Class="mb-2">Pies</MudText>
            <MudTextField @bind-Value="dogName" Label="Imię psa" Variant="Variant.Outlined" Class="mb-3" />
            <MudNumericField @bind-Value="ageInMonths" Label="Wiek (miesiące)" Variant="Variant.Outlined" Min="0" Class="mb-3" />

            <MudAutocomplete T="GetBreedDto"
                             Value="selectedBreed"
                             ValueChanged="OnBreedChanged"
                             Label="Rasa"
                             Placeholder="Wpisz nazwę rasy"
                             SearchFunc="SearchBreeds"
                             ToStringFunc="@(b => b == null ? "" : b.Name)"
                             Variant="Variant.Outlined"
                             Class="mb-4" />
        }
        else
        {
            <MudAutocomplete T="GetDogDto"
                             Value="selectedDog"
                             ValueChanged="OnDogChanged"
                             Label="Pies"
                             Placeholder="Wpisz imię psa, rasę lub nazwisko właściciela"
                             SearchFunc="SearchDogs"
                             ToStringFunc="@(d => d == null ? "" : $"{d.Name} ({d.BreedName}) - {d.DogOwnerFullName}")"
                             Variant="Variant.Outlined"
                             Class="mb-3" />
        }

        @if (availableServices.Any())
        {
            <MudSelect T="GetServiceBreedDto" Value="selectedService" ValueChanged="OnServiceChanged"
                       Label="Usługa" Placeholder="Wybierz usługę"
                       ToStringFunc="@(s => s == null ? "" : $"{s.ServiceName} - {s.Price:0.00} zł")"
                       Variant="Variant.Outlined" Class="mb-3">
                @foreach (var sb in availableServices)
                {
                    <MudSelectItem T="GetServiceBreedDto" Value="sb">
                        @sb.ServiceName — @sb.Price.ToString("0.00") zł, @EnumLabels.Duration(sb.Duration)
                    </MudSelectItem>
                }
            </MudSelect>
        }
        else if (HasBreedSelected)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3">
                Brak pozycji cennika dla tej rasy
            </MudAlert>
        }

        <MudSelect T="GetGroomerDto" Value="selectedGroomer" ValueChanged="OnGroomerChanged"
                   Label="Groomer" Placeholder="Wybierz groomera"
                   ToStringFunc="@(g => g == null ? "" : $"{g.FirstName} {g.LastName}")"
                   Variant="Variant.Outlined" Class="mb-3">
            @foreach (var g in groomers)
            {
                <MudSelectItem T="GetGroomerDto" Value="g">@g.FirstName @g.LastName</MudSelectItem>
            }
        </MudSelect>

        <MudCheckBox @bind-Value="withAssistant" Label="Pomoc Groomerska" Class="mb-3" />

        @if (withAssistant)
        {
            <MudSelect T="GetGroomerDto" @bind-Value="selectedAssistant"
                       Label="Pomoc" Placeholder="Wybierz osobę"
                       ToStringFunc="@(g => g == null ? "" : $"{g.FirstName} {g.LastName}")"
                       Variant="Variant.Outlined" Class="mb-3">
                @foreach (var g in groomers.Where(g => selectedGroomer == null || g.Id != selectedGroomer.Id))
                {
                    <MudSelectItem T="GetGroomerDto" Value="g">@g.FirstName @g.LastName</MudSelectItem>
                }
            </MudSelect>
        }

        <MudGrid Class="mb-3">
            <MudItem xs="12" md="6">
                <MudDatePicker @bind-Date="selectedDate" Label="Data" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTimePicker @bind-Time="selectedTime" Label="Godzina" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.body2" Class="mb-2">Czas trwania</MudText>
        <DurationPicker @bind-Value="durationMinutes" />

        <MudTextField @bind-Value="notes" Label="Notatki do wizyty"
                      Variant="Variant.Outlined" Lines="2" Class="mt-3" />

        @if (errorMessage != null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@errorMessage</MudAlert>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Anuluj</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="isSaving" OnClick="SaveAsync">
            @(isSaving ? "Zapisywanie..." : "Zapisz")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public DateTime? InitialStart { get; set; }
    [Parameter] public DateTime? InitialEnd { get; set; }

    private bool withNewDog;
    private bool withAssistant;

    private string firstName = string.Empty;
    private string lastName = string.Empty;
    private string phone = string.Empty;
    private string dogName = string.Empty;
    private int ageInMonths;
    private GetBreedDto? selectedBreed;

    private List<GetDogDto> dogs = new();
    private List<GetGroomerDto> groomers = new();
    private List<GetBreedDto> breeds = new();
    private List<GetServiceBreedDto> allServices = new();
    private List<GetServiceBreedDto> availableServices = new();

    private GetDogDto? selectedDog;
    private GetServiceBreedDto? selectedService;
    private GetGroomerDto? selectedGroomer;
    private GetGroomerDto? selectedAssistant;
    private DateTime? selectedDate = DateTime.Today;
    private TimeSpan? selectedTime = new TimeSpan(9, 0, 0);
    private int durationMinutes = 60;
    private string? notes;

    private bool isSaving;
    private string? errorMessage;

    private bool HasBreedSelected => withNewDog ? selectedBreed != null : selectedDog != null;

    protected override async Task OnInitializedAsync()
    {
        if (InitialStart != null)
        {
            selectedDate = InitialStart.Value.Date;
            selectedTime = InitialStart.Value.TimeOfDay;

            if (InitialEnd != null)
            {
                var minutes = (int)(InitialEnd.Value - InitialStart.Value).TotalMinutes;
                if (minutes >= 15)
                    durationMinutes = minutes;
            }
        }

        dogs = await Api.GetAsync<List<GetDogDto>>("api/Dog") ?? new();
        groomers = await Api.GetAsync<List<GetGroomerDto>>("api/Groomer") ?? new();
        breeds = await Api.GetAsync<List<GetBreedDto>>("api/Breed") ?? new();
        allServices = await Api.GetAsync<List<GetServiceBreedDto>>("api/ServiceBreed/GetAllServiceBreeds") ?? new();
    }

    private Task<IEnumerable<GetDogDto>> SearchDogs(string value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult<IEnumerable<GetDogDto>>(dogs);

        var filtered = dogs.Where(d =>
            d.Name.Contains(value, StringComparison.OrdinalIgnoreCase) ||
            d.BreedName.Contains(value, StringComparison.OrdinalIgnoreCase) ||
            d.DogOwnerFullName.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(filtered);
    }

    private Task<IEnumerable<GetBreedDto>> SearchBreeds(string value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult<IEnumerable<GetBreedDto>>(breeds);

        var filtered = breeds.Where(b =>
            b.Name.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(filtered);
    }

    private void OnDogChanged(GetDogDto? dog)
    {
        selectedDog = dog;
        selectedService = null;
        FilterServices(dog?.BreedName);
    }

    private void OnBreedChanged(GetBreedDto? breed)
    {
        selectedBreed = breed;
        selectedService = null;
        FilterServices(breed?.Name);
    }

    private void OnGroomerChanged(GetGroomerDto? groomer)
    {
        selectedGroomer = groomer;

        if (selectedAssistant != null && groomer != null && selectedAssistant.Id == groomer.Id)
            selectedAssistant = null;
    }

    private void FilterServices(string? breedName)
    {
        availableServices = breedName == null
            ? new()
            : allServices
                .Where(s => s.BreedName == breedName && s.Status == ActiveStatusEnum.Active)
                .ToList();
    }

    private void OnServiceChanged(GetServiceBreedDto? service)
    {
        selectedService = service;

        if (service != null && InitialEnd == null)
            durationMinutes = service.Duration;
    }

    private async Task SaveAsync()
    {
        errorMessage = null;

        if (withNewDog)
        {
            if (string.IsNullOrWhiteSpace(firstName) || string.IsNullOrWhiteSpace(lastName))
            {
                errorMessage = "Podaj imię i nazwisko właściciela";
                return;
            }

            if (string.IsNullOrWhiteSpace(phone))
            {
                errorMessage = "Podaj numer telefonu";
                return;
            }

            if (string.IsNullOrWhiteSpace(dogName))
            {
                errorMessage = "Podaj imię psa";
                return;
            }

            if (selectedBreed == null)
            {
                errorMessage = "Wybierz rasę";
                return;
            }
        }
        else if (selectedDog == null)
        {
            errorMessage = "Wybierz psa";
            return;
        }

        if (selectedService == null)
        {
            errorMessage = "Wybierz usługę";
            return;
        }

        if (selectedGroomer == null)
        {
            errorMessage = "Wybierz groomera";
            return;
        }

        if (withAssistant && selectedAssistant == null)
        {
            errorMessage = "Wybierz osobę do pomocy";
            return;
        }

        if (selectedDate == null || selectedTime == null)
        {
            errorMessage = "Podaj datę i godzinę";
            return;
        }

        if (durationMinutes <= 0)
        {
            errorMessage = "Podaj czas trwania";
            return;
        }

        isSaving = true;

        try
        {
            var visitDate = selectedDate.Value.Date.Add(selectedTime.Value);
            var assistantId = withAssistant ? selectedAssistant?.Id : null;
            HttpResponseMessage response;

            if (withNewDog)
            {
                var dto = new CreateVisitWithNewDogDto
                {
                    FirstName = firstName,
                    LastName = lastName,
                    Phone = phone,
                    DogName = dogName,
                    AgeInMonths = ageInMonths,
                    BreedId = selectedBreed!.Id,
                    GroomerId = selectedGroomer.Id,
                    AssistantGroomerId = assistantId,
                    ServiceBreedId = selectedService.Id,
                    Date = visitDate,
                    DurationMinutes = durationMinutes,
                    Notes = notes
                };

                response = await Api.PostAsync("api/Visit/with-new-dog", dto);
            }
            else
            {
                var dto = new AddVisitDto
                {
                    DogId = selectedDog!.Id,
                    GroomerId = selectedGroomer.Id,
                    AssistantGroomerId = assistantId,
                    ServiceBreedId = selectedService.Id,
                    Date = visitDate,
                    DurationMinutes = durationMinutes,
                    Notes = notes
                };

                response = await Api.PostAsync("api/Visit", dto);
            }

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await ApiClient.ReadErrorAsync(response);
                return;
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            errorMessage = $"Błąd: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}