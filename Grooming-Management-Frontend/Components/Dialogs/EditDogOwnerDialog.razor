@using Grooming_Management_App.DTOs.DogOwner
@using Grooming_Management_App.DTOs.DogOwnerDTO
@using Grooming_Management_Frontend.Services
@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="firstName" Label="Imię" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="lastName" Label="Nazwisko" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="phone" Label="Telefon" Variant="Variant.Outlined" />
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Anuluj</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="isSaving" OnClick="SaveAsync">
            @(isSaving ? "Zapisywanie..." : "Zapisz")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public GetDogOwnerDto Owner { get; set; } = default!;

    private string firstName = string.Empty;
    private string lastName = string.Empty;
    private string phone = string.Empty;

    private bool isSaving;

    protected override void OnInitialized()
    {
        firstName = Owner.FirstName;
        lastName = Owner.LastName;
        phone = Owner.Phone;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(firstName) || string.IsNullOrWhiteSpace(lastName))
        {
            Snackbar.Add("Podaj imię i nazwisko", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(phone))
        {
            Snackbar.Add("Podaj numer telefonu", Severity.Warning);
            return;
        }

        isSaving = true;

        try
        {
            var dto = new EditDogOwnerDto
            {
                FirstName = firstName,
                LastName = lastName,
                Phone = phone
            };

            var response = await Api.PutAsync($"api/DogOwner/{Owner.Id}", dto);

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(await ApiClient.ReadErrorAsync(response), Severity.Error);
                return;
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}