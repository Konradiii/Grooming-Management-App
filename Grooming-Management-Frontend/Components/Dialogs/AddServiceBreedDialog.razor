@using Grooming_Management_App.DTOs.ServiceBreedDTO
@using Grooming_Management_App.DTOs.ServiceDTO
@using Grooming_Management_App.DTOs.Breed
@using Grooming_Management_Frontend.Services
@inject ApiClient Api

<MudDialog>
    <DialogContent>
        <MudCheckBox @bind-Value="withNewService" Label="Utwórz nową usługę" Class="mb-4" />

        @if (withNewService)
        {
            <MudTextField @bind-Value="newServiceName" Label="Nazwa usługi" Variant="Variant.Outlined" Class="mb-4" />
        }
        else
        {
            <MudAutocomplete T="GetServiceDto"
                             @bind-Value="selectedService"
                             Label="Usługa"
                             Placeholder="Wpisz nazwę usługi"
                             SearchFunc="SearchServices"
                             ToStringFunc="@(s => s == null ? "" : s.Name)"
                             Variant="Variant.Outlined"
                             Class="mb-4" />
        }

        <MudAutocomplete T="GetBreedDto"
                         @bind-Value="selectedBreed"
                         Label="Rasa"
                         Placeholder="Wpisz nazwę rasy"
                         SearchFunc="SearchBreeds"
                         ToStringFunc="@(b => b == null ? "" : b.Name)"
                         Variant="Variant.Outlined"
                         Class="mb-3" />

        <MudNumericField @bind-Value="price" Label="Cena (zł)" Variant="Variant.Outlined" Min="0" Class="mb-3" />
        <MudNumericField @bind-Value="duration" Label="Czas trwania (min)" Variant="Variant.Outlined" Min="0" />

        @if (errorMessage != null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@errorMessage</MudAlert>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Anuluj</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="isSaving" OnClick="SaveAsync">
            @(isSaving ? "Zapisywanie..." : "Zapisz")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private bool withNewService;
    private string newServiceName = string.Empty;
    private GetServiceDto? selectedService;

    private GetBreedDto? selectedBreed;
    private decimal price;
    private int duration;

    private List<GetServiceDto> services = new();
    private List<GetBreedDto> breeds = new();

    private string? errorMessage;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        services = await Api.GetAsync<List<GetServiceDto>>("api/Service") ?? new();
        breeds = await Api.GetAsync<List<GetBreedDto>>("api/Breed") ?? new();
    }

    private Task<IEnumerable<GetServiceDto>> SearchServices(string value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult<IEnumerable<GetServiceDto>>(services);

        var filtered = services.Where(s =>
            s.Name.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(filtered);
    }

    private Task<IEnumerable<GetBreedDto>> SearchBreeds(string value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult<IEnumerable<GetBreedDto>>(breeds);

        var filtered = breeds.Where(b =>
            b.Name.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(filtered);
    }

    private async Task SaveAsync()
    {
        errorMessage = null;

        if (selectedBreed == null)
        {
            errorMessage = "Wybierz rasę";
            return;
        }

        if (price <= 0)
        {
            errorMessage = "Podaj cenę";
            return;
        }

        if (duration <= 0)
        {
            errorMessage = "Podaj czas trwania";
            return;
        }

        if (withNewService)
        {
            if (string.IsNullOrWhiteSpace(newServiceName))
            {
                errorMessage = "Podaj nazwę usługi";
                return;
            }
        }
        else if (selectedService == null)
        {
            errorMessage = "Wybierz usługę";
            return;
        }

        isSaving = true;

        try
        {
            HttpResponseMessage response;

            if (withNewService)
            {
                var dto = new CreateServiceBreedWithServiceDto
                {
                    ServiceName = newServiceName,
                    BreedId = selectedBreed.Id,
                    Price = price,
                    Duration = duration
                };

                response = await Api.PostAsync("api/ServiceBreed/with-service", dto);
            }
            else
            {
                var dto = new CreateServiceBreedDto
                {
                    ServiceId = selectedService!.Id,
                    BreedId = selectedBreed.Id,
                    Price = price,
                    Duration = duration
                };

                response = await Api.PostAsync("api/ServiceBreed", dto);
            }

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await ApiClient.ReadErrorAsync(response);
                return;
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            errorMessage = $"Błąd: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}