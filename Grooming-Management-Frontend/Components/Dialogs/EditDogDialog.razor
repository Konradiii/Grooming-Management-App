@using Grooming_Management_App.DTOs.DogDTO
@using Grooming_Management_Frontend.Services
@using Grooming_Management_Frontend.Components.Shared
@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="dogName" Label="Imię psa" Variant="Variant.Outlined" Class="mb-3" />
        <MudText Typo="Typo.caption" Class="mud-input-label">Wiek</MudText>
        <div class="mb-3">
            <AgePicker @bind-Value="ageInMonths" />
        </div>

        <BreedPicker @ref="breedPicker" InitialBreedName="@Dog.BreedName" />

        <MudTextField @bind-Value="notes" Label="Notatki" Variant="Variant.Outlined" Lines="3" Class="mt-2" />
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Anuluj</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="isSaving" OnClick="SaveAsync">
            @(isSaving ? "Zapisywanie..." : "Zapisz")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public GetDogDetailsDto Dog { get; set; } = default!;

    private BreedPicker breedPicker = default!;

    private string dogName = string.Empty;
    private int ageInMonths;
    private string? notes;

    private bool isSaving;

    protected override void OnInitialized()
    {
        dogName = Dog.Name;
        ageInMonths = Dog.AgeInMonths ?? 0;
        notes = Dog.Notes;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(dogName))
        {
            Snackbar.Add("Podaj imię psa", Severity.Warning);
            return;
        }

        if (!breedPicker.HasSelection)
        {
            Snackbar.Add("Wybierz lub wpisz rasę", Severity.Warning);
            return;
        }

        isSaving = true;

        try
        {
            var breedId = await breedPicker.ResolveBreedIdAsync();

            if (breedId == null) return;

            var dto = new UpdateDogDto
            {
                Name = dogName,
                AgeInMonths = ageInMonths,
                BreedId = breedId.Value,
                Notes = notes,
                DogOwnerId = Dog.DogOwnerId
            };

            var response = await Api.PutAsync($"api/Dog/{Dog.Id}", dto);

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(await ApiClient.ReadErrorAsync(response), Severity.Error);
                return;
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}