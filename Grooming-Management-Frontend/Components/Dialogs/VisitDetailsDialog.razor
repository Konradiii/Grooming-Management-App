@using Grooming_Management_App.DTOs.VisitDTO
@using Grooming_Management_App.DTOs.GroomerDTO
@using Grooming_Management_App.DTOs.ServiceBreedDTO
@using Grooming_Management_App.Enums
@using Grooming_Management_Frontend.Services
@inject ApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (isLoading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (visit == null)
        {
            <MudAlert Severity="Severity.Error">Nie znaleziono wizyty</MudAlert>
        }
        else
        {
            <MudText Typo="Typo.h6">@visit.DogName</MudText>
            <MudText Typo="Typo.body2" Class="mb-4">@visit.BreedName</MudText>

            @if (!isEditing)
            {
                <MudSimpleTable Dense="true" Elevation="0" Class="mb-2">
                    <tbody>
                        <tr>
                            <td><MudText Typo="Typo.body2">Właściciel</MudText></td>
                            <td>@visit.DogOwnerFullName</td>
                        </tr>
                        <tr>
                            <td><MudText Typo="Typo.body2">Termin</MudText></td>
                            <td>@EnumLabels.LocalDateTime(visit.Date)</td>
                        </tr>
                        <tr>
                            <td><MudText Typo="Typo.body2">Czas trwania</MudText></td>
                            <td>@EnumLabels.Duration(visit.EstimatedDuration)</td>
                        </tr>
                        <tr>
                            <td><MudText Typo="Typo.body2">Groomer</MudText></td>
                            <td>@visit.GroomerFullName</td>
                        </tr>
                        @if (visit.AssistantGroomerFullName != null)
                        {
                            <tr>
                                <td><MudText Typo="Typo.body2">Pomoc</MudText></td>
                                <td>@visit.AssistantGroomerFullName</td>
                            </tr>
                        }
                        <tr>
                            <td><MudText Typo="Typo.body2">Usługa</MudText></td>
                            <td>@visit.ServiceName</td>
                        </tr>
                        <tr>
                            <td><MudText Typo="Typo.body2">Sugerowana cena</MudText></td>
                            <td>@visit.ProposedPrice.ToString("0.00") zł</td>
                        </tr>
                    </tbody>
                </MudSimpleTable>

                @if (!string.IsNullOrWhiteSpace(visit.Notes))
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">@visit.Notes</MudAlert>
                }

                <div class="mb-4">
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Edit"
                               OnClick="BeginEditAsync">
                        Edytuj wizytę
                    </MudButton>

                    @if (CanSendPickup)
                    {
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.Sms"
                                   Disabled="isSendingSms"
                                   OnClick="SendPickupSmsAsync"
                                   Class="ml-2">
                            @(isSendingSms ? "Wysyłanie..." : "Powiadom o odbiorze")
                        </MudButton>
                    }
                    else if (visit.PickupNotificationSent)
                    {
                        <MudText Typo="Typo.caption" Class="ml-2">
                            SMS o odbiorze został wysłany
                        </MudText>
                    }
                </div>
            }
            else
            {
                <MudGrid Spacing="2" Class="mb-3">
                    <MudItem xs="7">
                        <MudDatePicker @bind-Date="editDate" Label="Data"
                                       Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="5">
                        <MudTimePicker @bind-Time="editTime" Label="Godzina"
                                       Variant="Variant.Outlined" />
                    </MudItem>
                </MudGrid>

                <MudSelect T="int" @bind-Value="editGroomerId" Label="Groomer"
                           Variant="Variant.Outlined" Class="mb-3">
                    @foreach (var g in groomers)
                    {
                        <MudSelectItem T="int" Value="@g.Id">@g.FirstName @g.LastName</MudSelectItem>
                    }
                </MudSelect>

                <MudText Typo="Typo.caption" Class="mud-input-label">Czas trwania</MudText>
                <div class="mb-3">
                    <DurationPicker @bind-Value="editDuration" />
                </div>

                <MudAutocomplete T="GetServiceBreedDto"
                                 @bind-Value="editServiceBreed"
                                 Label="Usługa"
                                 Placeholder="Wpisz nazwę usługi"
                                 SearchFunc="SearchServiceBreeds"
                                 ToStringFunc="@(sb => sb == null ? "" : sb.ServiceName)"
                                 Clearable="true"
                                 Variant="Variant.Outlined"
                                 Class="mb-3" />

                <MudNumericField @bind-Value="editProposedPrice" Label="Sugerowana cena (zł)"
                                 Variant="Variant.Outlined" Min="0" Class="mb-3" />

                <MudTextField @bind-Value="editNotes" Label="Notatki"
                              Variant="Variant.Outlined" Lines="2" Class="mb-3" />

                <MudCheckBox @bind-Value="ignoreOverlap"
                             Label="Pozwól na nakładanie się wizyt"
                             Dense="true" Class="mb-3" />

                <MudButton Variant="Variant.Text" OnClick="CancelEdit" Class="mb-4">
                    Anuluj edycję
                </MudButton>
            }

            <MudSelect T="StatusEnum" @bind-Value="status" Label="Status"
                       Variant="Variant.Outlined" Class="mb-3">
                <MudSelectItem T="StatusEnum" Value="StatusEnum.Scheduled">Zaplanowana</MudSelectItem>
                <MudSelectItem T="StatusEnum" Value="StatusEnum.Completed">Ukończona</MudSelectItem>
                <MudSelectItem T="StatusEnum" Value="StatusEnum.Cancelled">Odwołana</MudSelectItem>
                <MudSelectItem T="StatusEnum" Value="StatusEnum.NoShow">Nie przyszedł</MudSelectItem>
            </MudSelect>

            @if (status == StatusEnum.Completed)
            {
                <MudNumericField @bind-Value="finalPrice" Label="Cena końcowa (zł)"
                                 Variant="Variant.Outlined" Min="0" />
            }
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Zamknij</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="isSaving" OnClick="SaveAsync">
            @(isSaving ? "Zapisywanie..." : "Zapisz")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int VisitId { get; set; }

    private static readonly TimeZoneInfo PolishTime =
        TimeZoneInfo.FindSystemTimeZoneById("Europe/Warsaw");

    private GetVisitDetailsDto? visit;
    private StatusEnum status;
    private decimal finalPrice;

    private bool isEditing;
    private DateTime? editDate;
    private TimeSpan? editTime;
    private int editGroomerId;
    private int editDuration;
    private GetServiceBreedDto? editServiceBreed;
    private decimal editProposedPrice;
    private string? editNotes;
    private bool ignoreOverlap;

    private List<GetGroomerDto> groomers = new();
    private List<GetServiceBreedDto> serviceBreeds = new();

    private bool isLoading = true;
    private bool isSaving;
    private bool isSendingSms;

    private bool CanSendPickup =>
        visit != null
        && !visit.PickupNotificationSent
        && visit.Status != StatusEnum.Cancelled
        && visit.Status != StatusEnum.NoShow;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            visit = await Api.GetAsync<GetVisitDetailsDto>($"api/Visit/{VisitId}");

            if (visit != null)
            {
                status = visit.Status;
                finalPrice = visit.FinalPrice ?? visit.ProposedPrice;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nie udało się pobrać danych: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SendPickupSmsAsync()
    {
        if (visit == null) return;

        var parameters = new DialogParameters
        {
            ["OwnerName"] = visit.DogOwnerFullName
        };

        var confirmOptions = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var dialog = await DialogService.ShowAsync<PickupNotificationDialog>(
            "Powiadomienie o odbiorze", parameters, confirmOptions);

        var result = await dialog.Result;

        if (result is not { Canceled: false, Data: int minutes }) return;

        isSendingSms = true;

        try
        {
            var response = await Api.PostAsync<object?>(
                $"api/Notification/ready-for-pickup?visitId={VisitId}&timeToPickUpDogInMin={minutes}", null);

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(await ApiClient.ReadErrorAsync(response), Severity.Error);
                return;
            }

            visit.PickupNotificationSent = true;
            Snackbar.Add("SMS został wysłany", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSendingSms = false;
        }
    }

    private async Task BeginEditAsync()
    {
        if (visit == null) return;

        try
        {
            groomers = await Api.GetAsync<List<GetGroomerDto>>("api/Groomer") ?? new();

            serviceBreeds = await Api.GetAsync<List<GetServiceBreedDto>>(
                $"api/ServiceBreed/GetAllServiceBreeds?breedId={visit.BreedId}&status={(int)ActiveStatusEnum.Active}") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nie udało się pobrać danych: {ex.Message}", Severity.Error);
            return;
        }

        var local = TimeZoneInfo.ConvertTimeFromUtc(visit.Date, PolishTime);

        editDate = local.Date;
        editTime = local.TimeOfDay;
        editGroomerId = visit.GroomerId;
        editDuration = visit.EstimatedDuration;
        editProposedPrice = visit.ProposedPrice;
        editNotes = visit.Notes;
        editServiceBreed = serviceBreeds.FirstOrDefault(sb => sb.Id == visit.ServiceBreedId);
        ignoreOverlap = false;

        isEditing = true;
    }

    private void CancelEdit()
    {
        isEditing = false;
    }

    private Task<IEnumerable<GetServiceBreedDto>> SearchServiceBreeds(string value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult<IEnumerable<GetServiceBreedDto>>(serviceBreeds);

        var filtered = serviceBreeds.Where(sb =>
            sb.ServiceName.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(filtered);
    }

    private async Task SaveAsync()
    {
        if (visit == null) return;

        isSaving = true;

        try
        {
            if (isEditing)
            {
                if (editDate == null || editTime == null)
                {
                    Snackbar.Add("Podaj datę i godzinę", Severity.Warning);
                    return;
                }

                if (editDuration <= 0)
                {
                    Snackbar.Add("Czas trwania musi być większy od zera", Severity.Warning);
                    return;
                }

                var local = editDate.Value.Date + editTime.Value;
                var utc = TimeZoneInfo.ConvertTimeToUtc(
                    DateTime.SpecifyKind(local, DateTimeKind.Unspecified), PolishTime);

                var dto = new EditVisitDto
                {
                    Date = utc,
                    GroomerId = editGroomerId,
                    DurationMinutes = editDuration,
                    ServiceBreedId = editServiceBreed?.Id,
                    ProposedPrice = editProposedPrice,
                    Notes = editNotes,
                    IgnoreOverlap = ignoreOverlap
                };

                var editResponse = await Api.PutAsync($"api/Visit/{VisitId}", dto);

                if (!editResponse.IsSuccessStatusCode)
                {
                    Snackbar.Add(await ApiClient.ReadErrorAsync(editResponse), Severity.Error);
                    return;
                }
            }

            if (status != visit.Status)
            {
                var response = await Api.PutAsync<object?>(
                    $"api/Visit/{VisitId}/status?status={status}", null);

                if (!response.IsSuccessStatusCode)
                {
                    Snackbar.Add(await ApiClient.ReadErrorAsync(response), Severity.Error);
                    return;
                }
            }

            if (status == StatusEnum.Completed && finalPrice != visit.FinalPrice)
            {
                var priceParam = finalPrice.ToString(System.Globalization.CultureInfo.InvariantCulture);

                var response = await Api.PutAsync<object?>(
                    $"api/Visit/{VisitId}/final-price?finalPrice={priceParam}", null);

                if (!response.IsSuccessStatusCode)
                {
                    Snackbar.Add(await ApiClient.ReadErrorAsync(response), Severity.Error);
                    return;
                }
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}